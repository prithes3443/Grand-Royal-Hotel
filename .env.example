# ==============================================================================
# GRAND ROYAL HOTEL - Environment Configuration Template
# Copy this file to .env and configure with your environment-specific credentials.
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development

# Strict Debug Mode (Enforces strict debug toggles: false in production!)
FLASK_DEBUG=false

# Application Secret Key (Must be set to a cryptographically strong value in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-hotel-pos-2026

# Server Port (Optional override, defaults to 5000 or next available)
PORT=5000

# ==============================================================================
# Security & CSRF Protection (Flask-WTF)
# ==============================================================================
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600
SESSION_COOKIE_SECURE=false

# ==============================================================================
# Database Configuration
# ==============================================================================
# Force MySQL use. If false, system auto-detects MySQL and falls back to SQLite.
FORCE_MYSQL=false

# MySQL Credentials (When using MySQL service)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=grand_royal_hotel

# Direct Database URL Override (Optional, e.g. postgresql://, mysql+pymysql://, sqlite:///)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/grand_royal_hotel

# ==============================================================================
# AI & Data Science Module Configuration
# ==============================================================================
# Forecast horizon in days for inventory and demand forecasting
AI_DEMAND_FORECAST_DAYS=7

# Number of recommendations returned by intelligent pairing engine
AI_RECOMMENDER_TOP_N=4

# Enable AI Dynamic Pricing and Peak Hours Optimization
AI_DYNAMIC_PRICING_ENABLED=true
